<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group>
    <!-- Left Wing of Xephira 'X' -->
    <path
        android:pathData="M34,28 L46,28 L74,80 L62,80 Z">
      <aapt:attr name="android:fillColor">
        <gradient
            android:startX="34"
            android:startY="28"
            android:endX="74"
            android:endY="80"
            android:type="linear">
          <item android:offset="0.0" android:color="#00E5FF"/> <!-- Electric Cyan -->
          <item android:offset="1.0" android:color="#38BDF8"/> <!-- Sky Blue -->
        </gradient>
      </aapt:attr>
    </path>
    <!-- Right Wing of Xephira 'X' with Glass Overlay -->
    <path
        android:pathData="M74,28 L62,28 L34,80 L46,80 Z">
      <aapt:attr name="android:fillColor">
        <gradient
            android:startX="74"
            android:startY="28"
            android:endX="34"
            android:endY="80"
            android:type="linear">
          <item android:offset="0.0" android:color="#818CF8"/> <!-- Light Indigo -->
          <item android:offset="1.0" android:color="#C084FC"/> <!-- Glass Violet -->
        </gradient>
      </aapt:attr>
    </path>
    <!-- Center Core Glow Point -->
    <path
        android:pathData="M54,54m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0"
        android:fillAlpha="0.9">
      <aapt:attr name="android:fillColor">
        <gradient
            android:gradientRadius="7"
            android:centerX="54"
            android:centerY="54"
            android:type="radial">
          <item android:offset="0.0" android:color="#FFFFFF"/>
          <item android:offset="0.6" android:color="#A5F3FC"/>
          <item android:offset="1.0" android:color="#00E5FF"/>
        </gradient>
      </aapt:attr>
    </path>
  </group>
</vector>
