<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Continuous squircle curvature for enlarged 2x2 folder -->
    <corners android:radius="28dp" />

    <!-- Frosted liquid glass backdrop -->
    <solid android:color="@color/xephira_enlarged_folder_bg_light" />

    <!-- Specular light-catching rim -->
    <stroke
        android:width="1.2dp"
        android:color="@color/xephira_enlarged_folder_stroke" />

    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
